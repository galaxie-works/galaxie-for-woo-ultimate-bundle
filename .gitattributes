# Normalize line endings — keep diffs clean across Windows/macOS/Linux.
* text=auto eol=lf

# Binary assets
*.woff2 binary
*.png binary
*.jpg binary
*.webp binary
*.mo binary

# Never in the plugin package (git archive): development and internal notes.
/docs export-ignore
/tests export-ignore
/frontend export-ignore
/PLAN.md export-ignore
/README.md export-ignore
/acf-json/README.md export-ignore
/composer.json export-ignore
/composer.lock export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/pnpm-lock.yaml export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
