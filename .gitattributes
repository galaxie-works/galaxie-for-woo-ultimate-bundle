# Normalize line endings — keep diffs clean across Windows/macOS/Linux.
* text=auto eol=lf

# Binary assets
*.woff2 binary
*.png binary
*.jpg binary
*.webp binary
*.mo binary

# Never in the plugin package (git archive): development and internal notes.
/docs export-ignore
/tests export-ignore
/frontend export-ignore
/PLAN.md export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
